{
  "name": "dsh-plugin-boot-fx",
  "version": "1.3.2",
  "description": "Full-screen boot splash for the DeepSeek Harness Web GUI: whale mark, starfield, boot log, progress line, and a physical water-surface finale where 探索未至之境 emerges.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.template.js",
    "build.mjs",
    "assets/whale-path.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "boot",
    "splash",
    "animation",
    "ui",
    "water"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiYang19961001/dsh-plugin-boot-fx.git"
  },
  "homepage": "https://github.com/LiYang19961001/dsh-plugin-boot-fx",
  "bugs": {
    "url": "https://github.com/LiYang19961001/dsh-plugin-boot-fx/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
